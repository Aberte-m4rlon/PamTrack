# ==============================================================================
# PAMASAHE TRACKER – ORIENTAL MINDORO
# Copy this file to .env and fill in your Supabase project credentials.
# NEVER commit .env or expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
# ==============================================================================

# Supabase Client Configuration (Public / Browser-safe)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional OSRM Routing Endpoint (defaults to public OSRM demo server if omitted)
# For production, consider self-hosting OSRM or configuring a dedicated routing endpoint.
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# Optional Public App Metadata
VITE_APP_NAME=Pamasahe Tracker – Oriental Mindoro
VITE_APP_TAGLINE=Tamang Pamasahe. Ligtas na Biyahe.
VITE_APP_BASE_URL=http://localhost:5173
